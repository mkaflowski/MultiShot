<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">MultiShot</string>
    <string name="accessibility_label">MultiShot – screenshots</string>
    <string name="accessibility_description">Lets you take screenshots with a floating button, including on devices with multiple screens (e.g. AYN Thor). The service does not read window content; it only uses the screenshot function and draws the button overlay.</string>
    <string name="tile_label">Screenshot button</string>

    <!-- Status -->
    <string name="section_status">Service</string>
    <string name="status_running">The screenshot service is active.</string>
    <string name="status_stopped">The screenshot service is off. Enable \"MultiShot – screenshots\" in accessibility settings.</string>
    <string name="status_restricted_hint">If the app was installed from an APK file, Android 13+ may block the service (\"Restricted setting\"). In that case open App info → ⋮ menu → \"Allow restricted settings\" and try again.</string>
    <string name="btn_accessibility">Accessibility settings</string>
    <string name="btn_app_info">App info</string>

    <!-- Button -->
    <string name="section_button">Floating button</string>
    <string name="switch_button">Show floating button</string>
    <string name="label_transparency">Transparency: %1$d%%</string>
    <string name="label_size">Size: %1$d dp</string>
    <string name="label_button_display">Screen the button appears on</string>
    <string name="hint_button">Tap – take a screenshot. Drag – move. Long-press – open settings.</string>
    <string name="button_description">Take a screenshot</string>

