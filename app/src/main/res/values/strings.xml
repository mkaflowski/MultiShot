    <string name="section_feedback">Capture feedback</string>
    <string name="switch_vibrate">Light vibration</string>
    <string name="switch_sound">Shutter sound</string>
    <string name="switch_toast">\"Screenshot saved\" message</string>
    <string name="hint_feedback">Errors are always shown, even when the message is turned off.</string>

    <!-- Quick settings -->
    <string name="section_tile">Quick Settings</string>
